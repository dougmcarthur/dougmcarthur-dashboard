{
  "name": "dougmcarthur-dashboard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev",
    "dev:ui": "vite --config vite.config.ts",
    "build:ui": "vite build",
    "build": "npm run build:ui && npm run deploy",
    "predeploy": "npm run typecheck && npm run test",
    "deploy": "wrangler deploy",
    "typecheck": "npm run typecheck:api && npm run typecheck:ui",
    "typecheck:api": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc -p tsconfig.frontend.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dougmcarthur-music-hq --local",
    "db:migrate:remote": "wrangler d1 migrations apply dougmcarthur-music-hq --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "drizzle-orm": "^0.44.1",
    "hono": "^4.7.11",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.1",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.1"
  }
}
